{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": [
    "DATABASE_ADAPTER",
    "DATABASE_URL",
    "MIGRATION_DATABASE_URL",
    "DATABASE_URL_NON_POOLING",
    "POSTGRES_URL",
    "POSTGRES_URL_NON_POOLING",
    "DB_POSTGRES_URL",
    "DB_POSTGRES_URL_NON_POOLING",
    "PGSSLMODE",
    "DB_SSL",
    "CURSOR_TEAM_API_KEY",
    "CURSOR_ORGANIZATION_API_KEY",
    "CURSOR_ORGANIZATION_ID",
    "CURSOR_API_BASE_URL",
    "CURSOR_MONITOR_HOOK_TOKEN",
    "CURSOR_MONITOR_PUBLIC_URL",
    "DEPLOYMENT_URL",
    "CRON_SECRET"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {},
    "typecheck": {},
    "test": {
      "dependsOn": ["^build"],
      "passThroughEnv": [
        "DATABASE_ADAPTER",
        "DATABASE_URL",
        "MIGRATION_DATABASE_URL",
        "DATABASE_URL_NON_POOLING",
        "POSTGRES_URL",
        "POSTGRES_URL_NON_POOLING",
        "DB_POSTGRES_URL",
        "DB_POSTGRES_URL_NON_POOLING",
        "PGSSLMODE",
        "DB_SSL",
        "CURSOR_TEAM_API_KEY",
        "CURSOR_ORGANIZATION_API_KEY",
        "CURSOR_ORGANIZATION_ID",
        "CURSOR_API_BASE_URL",
        "CURSOR_MONITOR_HOOK_TOKEN",
        "CURSOR_MONITOR_PUBLIC_URL",
        "DEPLOYMENT_URL",
        "CRON_SECRET"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
