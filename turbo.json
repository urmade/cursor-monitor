{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": [
    "DB_POSTGRES_URL",
    "DB_POSTGRES_URL_NON_POOLING",
    "DB_SSL",
    "FLAG_P3_GATES",
    "RUN_RLS_GRANTS_TEST"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {},
    "typecheck": {},
    "test": {
      "dependsOn": ["^build"],
      "passThroughEnv": [
        "DB_POSTGRES_URL",
        "DB_POSTGRES_URL_NON_POOLING",
        "DB_SSL",
        "FLAG_P3_GATES",
        "RUN_RLS_GRANTS_TEST"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
