# Local development only — copy to .env.local (never commit real values).
# Production/preview secrets go through: python3 scripts/secrets.py add --scope shared --key …

# Cursor Cloud Agents
CURSOR_API_KEY=
CURSOR_SERVICE_ACCOUNT_KEY=
CURSOR_ADMIN_API_KEY=
CURSOR_AUTOMATION_KEY=

# Optional — Monitoring resolves GitHub PR titles when set (private repos need this)
GITHUB_TOKEN=

# Cron + deployment protection
CRON_SECRET=
VERCEL_PROTECTION_BYPASS=
NEXUS_VERCEL_BYPASS=
DEPLOYMENT_URL=http://localhost:3000

# MCP
MCP_TOKEN_SIGNING_KEY=

# Upstash Redis (rate limits) — provisioned via app-manifest integrations.redis
REDIS_KV_REST_API_URL=
REDIS_KV_REST_API_TOKEN=

# Supabase Postgres (local docker-compose defaults below)
DB_POSTGRES_URL=postgres://nexus:nexus@localhost:5432/nexus
DB_POSTGRES_URL_NON_POOLING=postgres://nexus:nexus@localhost:5432/nexus
