# Local development only — copy to .env.local (never commit real values).
# Production/preview secrets go through: python3 scripts/secrets.py add --scope shared --key …

# Database connection for the default PostgreSQL adapter.
DATABASE_URL=
# MIGRATION_DATABASE_URL=  # optional direct connection when DATABASE_URL uses a pooler

# Public URL embedded in Team Hook script downloads.
# CURSOR_MONITOR_PUBLIC_URL=http://localhost:3000

# Dedicated ingestion token for Team Hook POST /api/hooks/events.
# See docs/hooks.md#hook-token.
# CURSOR_MONITOR_HOOK_TOKEN=

# Cursor Team API polling (optional locally; use Operations → Sync now instead).
# Set one key or many comma-/newline-separated keys. Organization credentials
# still take precedence when both organization key and ID are configured.
# CURSOR_TEAM_API_KEY=
# CURSOR_TEAM_API_KEYS=
# CURSOR_ORGANIZATION_API_KEY=
# CURSOR_ORGANIZATION_ID=
# CURSOR_API_BASE_URL=https://api.cursor.com
