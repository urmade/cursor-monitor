# Local development only — copy to .env.local (never commit real values).
# Production/preview secrets go through: python3 scripts/secrets.py add --scope shared --key …

# Cursor Team API polling. Configure either a Team API key or both
# Organization values. Organization credentials take precedence.
CURSOR_TEAM_API_KEY=
CURSOR_ORGANIZATION_API_KEY=
CURSOR_ORGANIZATION_ID=
CURSOR_API_BASE_URL=https://api.cursor.com

# Inbound hook authentication is separate from the deployment protection bypass.
CURSOR_MONITOR_HOOK_TOKEN=
CRON_SECRET=
VERCEL_PROTECTION_BYPASS=
CURSOR_MONITOR_PUBLIC_URL=http://localhost:3000

# One selected database. PostgreSQL is the default adapter;
# MIGRATION_DATABASE_URL should be direct when DATABASE_URL uses a pooler.
DATABASE_ADAPTER=postgres
DATABASE_URL=
MIGRATION_DATABASE_URL=
PGSSLMODE=

# Existing deployments may use these provider aliases instead. Do not set both
# canonical and alias values unless DATABASE_URL should take precedence.
DB_POSTGRES_URL=
DB_POSTGRES_URL_NON_POOLING=
